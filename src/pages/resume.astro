---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import { profile, type Job } from '../data/profile';

/*
 * This page is the résumé. public/resume.pdf is rendered FROM it, so the two
 * can never drift — and both are driven by src/data/profile.ts, same as the
 * rest of the site. See the README for the regeneration command.
 */

type Company = {
  company: string;
  location?: string;
  url?: string;
  roles: Job[];
};

// Collapse consecutive roles at the same employer into one block, so a
// promotion reads as progression rather than three separate jobs.
const companies: Company[] = [];
for (const job of profile.work) {
  const current = companies.at(-1);
  if (current && current.company === job.company) {
    current.roles.push(job);
    current.url ??= job.url;
  } else {
    companies.push({
      company: job.company,
      location: job.location,
      url: job.url,
      roles: [job],
    });
  }
}

/** Span across every role held at one employer. */
const tenure = (c: Company) => `${c.roles.at(-1)!.start} — ${c.roles[0]!.end}`;

/** Union of the tech listed on each role, first occurrence wins. */
const techFor = (c: Company) => [...new Set(c.roles.flatMap((r) => r.tech ?? []))];

const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const contacts = [
  profile.location,
  profile.email,
  profile.phone,
  bare(profile.social.github),
  bare(profile.social.linkedin),
].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — Résumé</title>
    <meta name="description" content={`Résumé of ${profile.name}, ${profile.role}.`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="noindex" />
  </head>

  <body>
    <button class="print-button" type="button" onclick="window.print()">
      Print / Save as PDF
    </button>

    <main class="sheet">
      <header class="head">
        <h1>{profile.name}</h1>
        <p class="head__role">{profile.role}</p>
        <p class="head__contacts">
          {
            contacts.map((item, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                <span class="nowrap">{item}</span>
              </>
            ))
          }
        </p>
      </header>

      <section class="block">
        <h2>Summary</h2>
        <p class="summary">{profile.summary}</p>
      </section>

      <section class="block">
        <h2>Experience</h2>
        {
          companies.map((c) => (
            <article class="company">
              <div class="row">
                <h3 class="company__name">{c.company}</h3>
                <span class="row__meta">{tenure(c)}</span>
              </div>
              {c.location && <p class="company__location">{c.location}</p>}

              {c.roles.map((role) => (
                <div class="role">
                  <div class="row">
                    <h4 class="role__title">{role.role}</h4>
                    <span class="row__meta">
                      {role.start} — {role.end}
                    </span>
                  </div>
                  <p class="role__summary">{role.summary}</p>
                  {role.highlights && role.highlights.length > 0 && (
                    <ul class="bullets">
                      {role.highlights.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}

              {techFor(c).length > 0 && (
                <p class="tech">
                  <span class="tech__label">Tech</span>
                  {techFor(c).join(' · ')}
                </p>
              )}
            </article>
          ))
        }
      </section>

      <section class="block">
        <h2>Skills</h2>
        <dl class="skills">
          {
            profile.stack.map((group) => (
              <div class="skills__row">
                <dt>{group.title}</dt>
                <dd>{group.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="block">
        <h2>Projects</h2>
        {
          profile.projects.map((project) => (
            <div class="project">
              <div class="row">
                <h3 class="project__name">{project.name}</h3>
                <span class="row__meta">{project.year}</span>
              </div>
              <p class="project__blurb">{project.blurb}</p>
              <p class="tech">
                <span class="tech__label">Tech</span>
                {project.tech.join(' · ')}
              </p>
            </div>
          ))
        }
      </section>

      <section class="block">
        <h2>Education</h2>
        {
          profile.education.map((school) => (
            <div class="row">
              <div>
                <h3 class="school__name">{school.school}</h3>
                <p class="school__degree">{school.degree}</p>
              </div>
              <span class="row__meta">
                {school.start} — {school.end}
              </span>
            </div>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style is:global>
  /* Print-first: black on white, single column so applicant tracking systems
     parse it in the right order. The screen view is the same sheet on a grey
     desk. */

  @page {
    size: A4;
    margin: 13mm 14mm;
  }

  * {
    margin: 0;
    box-sizing: border-box;
  }

  body {
    background: #eceae6;
    color: #14140f;
    font-family: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: 10pt;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    padding: 2rem 1rem 4rem;
  }

  .sheet {
    background: #fff;
    max-width: 210mm;
    margin-inline: auto;
    padding: 13mm 14mm;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.12);
  }

  h1,
  h2,
  h3,
  h4 {
    font-weight: 600;
    line-height: 1.2;
  }

  /* ── Header ─────────────────────────────────────────────────────────── */

  .head {
    border-bottom: 1.5px solid #14140f;
    padding-bottom: 3mm;
    margin-bottom: 5mm;
  }

  .head h1 {
    font-size: 22pt;
    letter-spacing: -0.03em;
  }

  .head__role {
    font-size: 11.5pt;
    color: #45443c;
    margin-top: 0.5mm;
  }

  .head__contacts {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 7.8pt;
    color: #45443c;
    margin-top: 2.5mm;
    line-height: 1.7;
  }

  .sep {
    color: #a8a69c;
    margin-inline: 1.6mm;
  }

  /* Keep phone numbers and URLs from breaking across lines. */
  .nowrap {
    white-space: nowrap;
  }

  /* ── Blocks ─────────────────────────────────────────────────────────── */

  .block {
    margin-top: 5.5mm;
    break-inside: auto;
  }

  .block h2 {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 7.6pt;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6960;
    border-bottom: 0.5px solid #d6d3ca;
    padding-bottom: 1.2mm;
    margin-bottom: 3mm;
    /* Never let a section heading sit alone at the foot of a page. */
    break-after: avoid;
    page-break-after: avoid;
  }

  .summary {
    max-width: 62em;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
  }

  .row__meta {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 7.8pt;
    color: #6b6960;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Experience ─────────────────────────────────────────────────────── */

  .company {
    margin-bottom: 4.5mm;
    break-inside: avoid;
  }

  .company:last-child {
    margin-bottom: 0;
  }

  .company__name {
    font-size: 11pt;
    letter-spacing: -0.01em;
  }

  .company__location {
    font-size: 8.4pt;
    color: #6b6960;
    margin-top: 0.3mm;
  }

  .role {
    margin-top: 2.4mm;
    padding-left: 3.5mm;
    border-left: 1px solid #ddd9d0;
  }

  .role__title {
    font-size: 9.6pt;
    font-weight: 600;
  }

  .role__summary {
    color: #35342c;
    margin-top: 0.6mm;
  }

  .bullets {
    margin-top: 1.2mm;
    padding-left: 4mm;
  }

  .bullets li {
    margin-bottom: 0.8mm;
    color: #35342c;
  }

  .tech {
    font-size: 8.4pt;
    color: #45443c;
    margin-top: 2.2mm;
  }

  .tech__label {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 7.2pt;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8c8a80;
    margin-right: 2mm;
  }

  /* ── Skills ─────────────────────────────────────────────────────────── */

  .skills__row {
    display: grid;
    grid-template-columns: 22mm 1fr;
    gap: 3mm;
    margin-bottom: 1.4mm;
  }

  .skills__row dt {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 7.6pt;
    color: #6b6960;
    padding-top: 0.6mm;
  }

  .skills__row dd {
    margin: 0;
  }

  /* ── Projects & education ───────────────────────────────────────────── */

  .project {
    margin-bottom: 3mm;
    break-inside: avoid;
  }

  .project:last-child {
    margin-bottom: 0;
  }

  .project__name {
    font-size: 9.8pt;
  }

  .project__blurb {
    color: #35342c;
    margin-top: 0.4mm;
  }

  .school__name {
    font-size: 9.8pt;
  }

  .school__degree {
    color: #45443c;
    font-size: 9.2pt;
  }

  /* ── Print affordance ───────────────────────────────────────────────── */

  .print-button {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    font: inherit;
    font-size: 8.5pt;
    background: #14140f;
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
  }

  @media print {
    body {
      background: #fff;
      padding: 0;
    }

    .sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }

    .print-button {
      display: none;
    }
  }
</style>
