---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import { profile, findPlaceholders } from '../data/profile';

// Fail loudly at build time rather than quietly publishing "TODO — ..." text.
const placeholders = findPlaceholders(profile);
if (placeholders.length > 0) {
  console.warn(
    `\n\u001b[33m⚠  ${placeholders.length} placeholder${placeholders.length === 1 ? '' : 's'} still in src/data/profile.ts:\u001b[0m\n` +
      placeholders.map((path) => `   · ${path}`).join('\n') +
      '\n',
  );
}

// Keep placeholder text out of search results and link previews.
const clean = (value: string, fallback: string) =>
  value.includes('TODO') ? fallback : value;

const title = clean(
  `${profile.name} — ${profile.role}`,
  `${profile.name} — Software Engineer`,
);
const description = clean(
  profile.seoDescription,
  `Portfolio of ${profile.name}, software engineer. Selected work, projects and ways to get in touch.`,
);
---

<Base title={title} description={description}>
  <Hero />

  <Section id="about" label="About">
    {profile.about.map((paragraph) => <p class="prose measure">{paragraph}</p>)}
  </Section>

  <Section id="work" label="Work">
    <Work />
  </Section>

  <Section id="projects" label="Projects">
    <Projects />
  </Section>

  <Section id="stack" label="Stack">
    <Stack />
  </Section>

  <Section id="education" label="Education">
    <Education />
  </Section>

  <Section id="contact" label="Contact">
    <Contact />
  </Section>
</Base>

<style>
  .prose {
    color: var(--text-muted);
    font-size: var(--step-0);
  }
</style>
